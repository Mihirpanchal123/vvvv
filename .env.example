# Optional — without these the app runs in local "guest mode" (data stays in the browser).
# Create a Supabase project, run supabase/migrations/*.sql, enable Email (magic link) auth,
# and add http://localhost:3000/auth/callback to Auth → URL configuration → Redirect URLs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
