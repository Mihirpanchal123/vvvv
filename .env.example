# Optional — without these the app runs in local "guest mode" (data stays in the browser).
# Create a Supabase project, run supabase/migrations/*.sql, keep Email auth enabled (email + password),
# and add <origin>/auth/callback to Auth → URL configuration → Redirect URLs
# (e.g. http://localhost:3000/auth/callback and https://<site>.netlify.app/auth/callback).
# On Netlify, set these under Site configuration → Environment variables. They are inlined at build
# time, so redeploy after changing them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
